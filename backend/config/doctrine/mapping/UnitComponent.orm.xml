<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Entity\UnitComponent" table="unit_components">
        <id name="id" type="unit_component_id" column="id" length="36"><generator strategy="NONE"/></id>
        <field name="unitId" type="unit_id" column="unit_id" length="36"/>
        <field name="userId" type="user_id" column="user_id" length="36"/>
        <field name="label" type="string" column="label" length="255"/>
        <field name="quantityTotal" type="integer" column="quantity_total"/>
        <field name="quantityPainted" type="integer" column="quantity_painted"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>
        <indexes><index name="idx_unit_components_unit_id" columns="unit_id"/><index name="idx_unit_components_user_id" columns="user_id"/></indexes>
    </entity>
</doctrine-mapping>
