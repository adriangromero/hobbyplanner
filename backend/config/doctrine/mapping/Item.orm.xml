<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                  https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Domain\Entity\Item" table="items">

        <id name="id" type="item_id" column="id" length="36">
            <generator strategy="NONE"/>
        </id>

        <field name="projectId" type="project_id" column="project_id" length="36"/>
        <field name="userId" type="user_id" column="user_id" length="36"/>
        <field name="name" type="string" column="name" length="255"/>
        <field name="estimatedHours" type="float" column="estimated_hours"/>
        <field name="createdAt" type="datetime_immutable" column="created_at"/>
        <field name="updatedAt" type="datetime_immutable" column="updated_at"/>

        <indexes>
            <index name="idx_items_project_id" columns="project_id"/>
            <index name="idx_items_user_id" columns="user_id"/>
        </indexes>

    </entity>

</doctrine-mapping>
